# Copy to .env (same folder as docker-compose.yml); compose reads it on every
# command, so settings stay put across `up`, `restart` and `--force-recreate`.

# Reconstruction server the marshal forwards scans to. REQUIRED.
#   real recon:          RECON_HOST=<recon machine IP>
#   bundled test recon:  RECON_HOST=recon   (start with --profile test-recon)
RECON_HOST=
RECON_PORT=9002

# --dump = archive only, viewer off. Empty = viewer on (archiving is always on).
MARSHAL_DUMP=

# Scanner-side slice agent (`slice_agent --listen` on the MARS). Empty = off.
SLICE_AGENT_HOST=
SLICE_AGENT_PORT=9270

# Where scans, archives and marshal.log are written.
# SESSION_DATA_DIR=./session-data
