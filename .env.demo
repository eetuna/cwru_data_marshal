# CWRU Data Marshal Demo Environment Variables
# This file is sourced by demo-docker.sh and used by docker-compose.demo.yml

# Image streaming configuration
IMAGE_WIDTH=128               # Image width in pixels
IMAGE_HEIGHT=128              # Image height in pixels
IMAGE_SLICES=10               # Number of slices per volume
IMAGE_INTERVAL=50             # Streaming interval in ms (50ms = 20fps)
IMAGE_LOG_STRIDE=100             # Print frame info every N frames (0 = silent)

# ECG client configuration
ECG_INTERVAL=1                  # ECG sample interval in seconds
ECG_HEART_RATE=72               # Simulated heart rate in BPM

# Pose client configuration
POSE_INTERVAL=1               # Pose update interval in seconds
POSE_TRAJECTORY=circular        # Trajectory type: circular, linear, random

# Display configuration for viz-client (X11 GUI)
DISPLAY=:0                      # X11 display server (:0 = default local display)

# Data directory (relative to project root, or absolute path)
SESSION_DATA_DIR=./session-data # Where MRI data files are stored

# Demo runtime settings
DEMO_DURATION=120               # Demo run time in seconds (0 = infinite)
ENABLE_VIZ=true                 # Show visualization client window (requires X11)
CLEANUP_DATA=false              # Remove session-data/ after demo (set false to keep data)
MONITOR_INTERVAL=2              # Print robot client ops count every N seconds
