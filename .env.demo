# CWRU Data Marshal Demo Environment Variables
# This file is sourced by demo-docker.sh and used by docker-compose.demo.yml

# Image streaming configuration
IMAGE_WIDTH=64
IMAGE_HEIGHT=64
IMAGE_SLICES=3
IMAGE_INTERVAL=50               # 50ms = 20fps

# ECG client configuration
ECG_INTERVAL=1                # 0.5s = 500ms
ECG_HEART_RATE=72

# Pose client configuration
POSE_INTERVAL=1               # 0.1s = 100ms = 10Hz
POSE_TRAJECTORY=circular

# Display configuration
DISPLAY=:0

# Demo runtime settings
DEMO_DURATION=30                # Demo run time in seconds
ENABLE_VIZ=true                 # Show visualization client window
CLEANUP_DATA=true               # Remove mri-data volume after demo (set false to keep data)
MONITOR_INTERVAL=1              # Print robot client ops count every N seconds
