FROM python:3.11-slim

# Copy ECG waveform client
COPY clients/mocks/ecg_client.py /app/ecg_client.py

WORKDIR /app

# Disable Python output buffering so logs appear immediately
ENV PYTHONUNBUFFERED=1

# Default: run ecg_client as ISMRMRD waveform producer via POST /frame
CMD ["python3", "-u", "ecg_client.py", "--http", "http://mri-marshal:8080", "--count", "0", "--interval", "1.0"]
