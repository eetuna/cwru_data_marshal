# cwru/mock-recon:latest
#
# Mock reconstruction service for the v2 marshal.
# Accepts /header + /config + /frame + /close from marshal,
# performs reconstruction, and POSTs /image back to marshal.
#
# Listens on port 9002.

FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Python deps
RUN pip install --no-cache-dir \
        ismrmrd \
        numpy \
        requests

# Copy mock recon server
COPY .worktrees/mri_data_marshal/docker/mock-recon/mock_recon.py /opt/mock-recon/mock_recon.py

EXPOSE 9002

CMD ["python3", "/opt/mock-recon/mock_recon.py"]
