FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    python3 \
    python3-pip \
    && pip3 install --no-cache-dir --break-system-packages h5py numpy \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/webgl

# Node dependencies
COPY package.json ./
RUN npm install --production

# Application files
COPY server.js backend-write-server.js file_routes.json ./
COPY read_hdf5.py ./
COPY index.html webgl-demo.js render-2d-image.js gl-matrix-min.js ./

# Environment variables for marshal connections
ENV NODE_ENV=production
ENV ROBOT_MARSHAL_HOST=robot-marshal
ENV ROBOT_MARSHAL_PORT=8081
ENV MRI_MARSHAL_HOST=mri-marshal
ENV MRI_MARSHAL_PORT=8080
ENV HDF5_USE_FILE_LOCKING=FALSE

EXPOSE 3000 3001

CMD ["sh", "-c", "node backend-write-server.js & exec node server.js"]
