FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/webgl

# Copy source files from build context (webgl worktree)
COPY package.json ./
RUN npm install --production

COPY server.js backend-write-server.js file_routes.json ./
COPY index.html webgl-demo.js render-2d-image.js gl-matrix-min.js ./

# Patch server URLs to use environment variables (same pattern as robot-clients sed patches)
RUN sed -i "s|'http://server:8080'|'http://' + (process.env.ROBOT_MARSHAL_HOST || 'robot-marshal') + ':' + (process.env.ROBOT_MARSHAL_PORT || '8081')|" server.js && \
    sed -i "s|'http://localhost:8080'|'http://localhost:' + (process.env.ROBOT_MARSHAL_PORT || '8081')|" server.js && \
    sed -i "s|'http://streaming-server:8081'|'http://' + (process.env.MRI_MARSHAL_HOST || 'mri-marshal') + ':' + (process.env.MRI_MARSHAL_PORT || '8080')|" server.js && \
    sed -i "s|'http://127.0.0.1:8081'|'http://localhost:' + (process.env.MRI_MARSHAL_PORT || '8080')|" server.js && \
    sed -i "s|'http://server:8080'|'http://' + (process.env.ROBOT_MARSHAL_HOST || 'robot-marshal') + ':' + (process.env.ROBOT_MARSHAL_PORT || '8081')|" backend-write-server.js && \
    sed -i "s|'http://localhost:8080'|'http://localhost:' + (process.env.ROBOT_MARSHAL_PORT || '8081')|" backend-write-server.js

# Environment variables for marshal connections (matching existing client pattern)
ENV NODE_ENV=production
ENV ROBOT_MARSHAL_HOST=robot-marshal
ENV ROBOT_MARSHAL_PORT=8081
ENV MRI_MARSHAL_HOST=mri-marshal
ENV MRI_MARSHAL_PORT=8080

EXPOSE 3000 3001

CMD ["sh", "-c", "node backend-write-server.js & exec node server.js"]
