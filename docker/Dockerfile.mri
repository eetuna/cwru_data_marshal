FROM ubuntu:22.04

ARG REPO_URL=https://github.com/cwru-mercis/cwru_data_marshal.git
ARG BRANCH=mri-data-marhsal

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libboost-all-dev \
    libhdf5-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch "$BRANCH" "$REPO_URL" /opt/mri

RUN cmake -S /opt/mri -B /opt/mri/build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build /opt/mri/build --target marshal

WORKDIR /opt/mri
VOLUME ["/data"]
EXPOSE 8080 8090

CMD ["/opt/mri/build/marshal", "--http", "0.0.0.0:8080", "--ws", "0.0.0.0:8090", "--data", "/data", "--sink", "mrd"]
