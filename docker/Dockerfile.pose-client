FROM python:3.11-slim

# Copy pose client
COPY clients/mocks/pose_client.py /app/pose_client.py

WORKDIR /app

# Disable Python output buffering so logs appear immediately
ENV PYTHONUNBUFFERED=1

# Default: run pose_client posting to /pose
CMD ["python3", "-u", "pose_client.py", "--http", "http://mri-marshal:8080", "--count", "0", "--interval", "0.5"]
