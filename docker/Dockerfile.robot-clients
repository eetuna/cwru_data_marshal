FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    libeigen3-dev \
    && rm -rf /var/lib/apt/lists/*

# CRM headers use #include <eigen5/Eigen/Dense> — symlink eigen3 to eigen5
RUN ln -s /usr/include/eigen3 /usr/include/eigen5

# Copy source files from build context (robot worktree)
COPY client-catheter-tracking.cpp /opt/robot/
COPY client-controller.cpp /opt/robot/
COPY client-front-end.cpp /opt/robot/
COPY client-planning.cpp /opt/robot/
COPY client-surface-tracking.cpp /opt/robot/
COPY httplib.h json.hpp circularBuffer.hpp /opt/robot/
COPY file_routes.json file*.json /opt/robot/
COPY CRM_CPPImplementation/src/ /opt/robot/CRM_CPPImplementation/src/
COPY CRM_CPPImplementation/numerical/ /opt/robot/CRM_CPPImplementation/numerical/
COPY CRM_CPPImplementation/catheterdata/ /opt/robot/catheterdata/

WORKDIR /opt/robot

# Patch clients to use compact single-line output with client-specific prefixes
RUN sed -i 's/std::cout << "Read localization values: " << values.dump(2) << "\\n";/std::cout << "CATHETER: " << values.dump() << std::endl;/' client-catheter-tracking.cpp && \
    sed -i 's/std::cout << "Read values: " << values.dump(2) << "\\n";/std::cout << "CONTROLLER: " << values.dump() << std::endl;/' client-controller.cpp && \
    sed -i 's/std::cout << "Read values: " << values.dump(2) << "\\n";/std::cout << "PLANNING: " << values.dump() << std::endl;/' client-planning.cpp && \
    sed -i 's/std::cout << "Read values: " << values.dump(2) << "\\n";/std::cout << "FRONTEND: " << values.dump() << std::endl;/' client-front-end.cpp && \
    sed -i 's/std::cout << "Read values: " << values.dump(2) << "\\n";/std::cout << "SURFACE: " << values.dump() << std::endl;/' client-surface-tracking.cpp && \
    sed -i '/Result sent successfully/d' client-*.cpp

# Build all clients
RUN g++ -std=c++17 client-catheter-tracking.cpp -o catheter-tracking -lpthread && \
    g++ -std=c++17 -O2 client-controller.cpp \
    CRM_CPPImplementation/src/CRM_ForwardKinematics.cpp \
    CRM_CPPImplementation/src/CRM_BVPSolver.cpp \
    CRM_CPPImplementation/src/CRM_IVPSolver.cpp \
    CRM_CPPImplementation/src/CRM_IVPJacobian.cpp \
    CRM_CPPImplementation/src/CRM_CatheterClass.cpp \
    CRM_CPPImplementation/src/CRM_SupportFunctions.cpp \
    CRM_CPPImplementation/numerical/minpack.cpp \
    -I CRM_CPPImplementation/src \
    -I CRM_CPPImplementation/numerical \
    -o controller -lpthread && \
    g++ -std=c++17 client-front-end.cpp -o front-end -lpthread && \
    g++ -std=c++17 client-planning.cpp -o planning -lpthread && \
    g++ -std=c++17 client-surface-tracking.cpp -o surface-tracking -lpthread

# Environment variables for robot marshal connection
ENV ROBOT_MARSHAL_HOST=robot-marshal
ENV ROBOT_MARSHAL_PORT=8081

# Default: run catheter-tracking (override in docker-compose)
CMD ["./catheter-tracking"]
