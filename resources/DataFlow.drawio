        <mxCell id="QUOObzku_QAujZp85UTl-140" value="&lt;div style=&quot;text-align: center; text-wrap-mode: nowrap;&quot;&gt;Two data marshals: Robot Data Marshal, MRI Data Marshal&lt;/div&gt;&lt;div style=&quot;text-align: center; text-wrap-mode: nowrap;&quot;&gt;Could also have separation between MRI Data Marshal and maintaining connection from MRI&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;align=left;spacingLeft=5;" vertex="1" parent="QUOObzku_QAujZp85UTl-139">
