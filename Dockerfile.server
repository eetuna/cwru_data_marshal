FROM gcc:latest

# Create app directory
WORKDIR /app

# Copy source files
COPY server.cpp files.json httplib.h json.hpp circularBuffer.hpp ./
COPY  file1.json file2.json file3.json  /files/

# Build server
RUN g++ server.cpp -o server -pthread

# Expose port for server
EXPOSE 8080

# Run server
CMD ["./server"]
